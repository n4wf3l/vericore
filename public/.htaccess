# SPA fallback + cache — Vericore

# Page 404 personnalisée (renvoie un vrai code HTTP 404)
ErrorDocument 404 /404.html

# Empêche Apache d'ajouter automatiquement un trailing slash aux URLs de dossier
# (évite la redirection chain /plombier-uccle → /plombier-uccle/)
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www → apex (vericore.be canonique)
  RewriteCond %{HTTP_HOST} ^www\.vericore\.be$ [NC]
  RewriteRule ^(.*)$ https://vericore.be/$1 [L,R=301]

  # FR est à la racine sans préfixe : redirect /fr/xxx → /xxx
  RewriteRule ^fr/?$ / [L,R=301]
  RewriteRule ^fr/(.*)$ /$1 [L,R=301]

  # Redirections métier : anciennes URLs "trade" → nouvelles URLs "profession" (SEO)
  # FR
  RewriteRule ^plomberie-(.+)$ /plombier-$1/ [L,R=301]
  RewriteRule ^electricite-(.+)$ /electricien-$1/ [L,R=301]
  RewriteRule ^chauffage-(.+)$ /chauffagiste-$1/ [L,R=301]
  RewriteRule ^menuiserie-(.+)$ /menuisier-$1/ [L,R=301]
  RewriteRule ^peinture-(.+)$ /peintre-$1/ [L,R=301]
  RewriteRule ^carrelage-(.+)$ /carreleur-$1/ [L,R=301]
  # NL
  RewriteRule ^nl/plomberie-(.+)$ /nl/loodgieter-$1/ [L,R=301]
  RewriteRule ^nl/electricite-(.+)$ /nl/elektricien-$1/ [L,R=301]
  RewriteRule ^nl/chauffage-(.+)$ /nl/verwarmingsinstallateur-$1/ [L,R=301]
  RewriteRule ^nl/climatisation-(.+)$ /nl/airco-installateur-$1/ [L,R=301]
  RewriteRule ^nl/menuiserie-(.+)$ /nl/schrijnwerker-$1/ [L,R=301]
  RewriteRule ^nl/peinture-(.+)$ /nl/schilder-$1/ [L,R=301]
  RewriteRule ^nl/carrelage-(.+)$ /nl/tegelzetter-$1/ [L,R=301]
  RewriteRule ^nl/renovation-(.+)$ /nl/renovatie-$1/ [L,R=301]
  # EN
  RewriteRule ^en/plomberie-(.+)$ /en/plumber-$1/ [L,R=301]
  RewriteRule ^en/electricite-(.+)$ /en/electrician-$1/ [L,R=301]
  RewriteRule ^en/chauffage-(.+)$ /en/heating-$1/ [L,R=301]
  RewriteRule ^en/climatisation-(.+)$ /en/air-conditioning-$1/ [L,R=301]
  RewriteRule ^en/menuiserie-(.+)$ /en/carpenter-$1/ [L,R=301]
  RewriteRule ^en/peinture-(.+)$ /en/painter-$1/ [L,R=301]
  RewriteRule ^en/carrelage-(.+)$ /en/tiler-$1/ [L,R=301]

  # Redirections cross-langue : FR slugs sur /nl/ ou /en/ (partages accidentels)
  RewriteRule ^nl/plombier-(.+)$ /nl/loodgieter-$1/ [L,R=301]
  RewriteRule ^nl/electricien-(.+)$ /nl/elektricien-$1/ [L,R=301]
  RewriteRule ^nl/chauffagiste-(.+)$ /nl/verwarmingsinstallateur-$1/ [L,R=301]
  RewriteRule ^nl/menuisier-(.+)$ /nl/schrijnwerker-$1/ [L,R=301]
  RewriteRule ^nl/peintre-(.+)$ /nl/schilder-$1/ [L,R=301]
  RewriteRule ^nl/carreleur-(.+)$ /nl/tegelzetter-$1/ [L,R=301]
  RewriteRule ^en/plombier-(.+)$ /en/plumber-$1/ [L,R=301]
  RewriteRule ^en/electricien-(.+)$ /en/electrician-$1/ [L,R=301]
  RewriteRule ^en/chauffagiste-(.+)$ /en/heating-$1/ [L,R=301]
  RewriteRule ^en/menuisier-(.+)$ /en/carpenter-$1/ [L,R=301]
  RewriteRule ^en/peintre-(.+)$ /en/painter-$1/ [L,R=301]
  RewriteRule ^en/carreleur-(.+)$ /en/tiler-$1/ [L,R=301]

  # NL slugs à la racine (sans préfixe) → FR équivalent
  RewriteRule ^loodgieter-(.+)$ /plombier-$1/ [L,R=301]
  RewriteRule ^elektricien-(.+)$ /electricien-$1/ [L,R=301]
  RewriteRule ^verwarmingsinstallateur-(.+)$ /chauffagiste-$1/ [L,R=301]
  RewriteRule ^schrijnwerker-(.+)$ /menuisier-$1/ [L,R=301]
  RewriteRule ^schilder-(.+)$ /peintre-$1/ [L,R=301]
  RewriteRule ^tegelzetter-(.+)$ /carreleur-$1/ [L,R=301]
  RewriteRule ^renovatie-(.+)$ /renovation-$1/ [L,R=301]

  # EN slugs à la racine (sans préfixe) → FR équivalent
  RewriteRule ^plumber-(.+)$ /plombier-$1/ [L,R=301]
  RewriteRule ^electrician-(.+)$ /electricien-$1/ [L,R=301]
  RewriteRule ^heating-(.+)$ /chauffagiste-$1/ [L,R=301]
  RewriteRule ^carpenter-(.+)$ /menuisier-$1/ [L,R=301]
  RewriteRule ^painter-(.+)$ /peintre-$1/ [L,R=301]
  RewriteRule ^tiler-(.+)$ /carreleur-$1/ [L,R=301]

  # Servir index.html si l'URL correspond à un dossier prérendu
  # (grâce à DirectorySlash Off, aucun trailing slash n'est ajouté par Apache)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)$ /$1/index.html [L]

  # Toute URL non résolue → 404.html avec vrai statut 404 (ErrorDocument ci-dessus)
  # Pas de SPA fallback en 200 : Google reçoit un vrai 404 pour les URLs inexistantes
</IfModule>

# Cache long pour assets hashés
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Pas de cache pour les HTML (contenu regénéré à chaque build)
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# Compression GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/xml+rss image/svg+xml
</IfModule>

# Sécurité minimale
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
